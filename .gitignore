# ==========================================
# SPAMIX: SMS Spam Detection Project .gitignore
# ==========================================

# Byte-compiled / optimized / Python caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDEs and Code Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Streamlit local settings & secrets
.streamlit/secrets.toml

# SQLite Lock & Journal files
database/*.db-journal
database/*.db-wal

# Temporary / Log files
*.log
scratch/
temp/

# Zip / Archives (keep repository clean)
*.zip
*.tar.gz
*.rar
